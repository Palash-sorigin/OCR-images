# Primary extraction is standard PaddleOCR. VLM is an optional fallback.
ENABLE_VLM=false
VLM_VERSION=v1.6

# OCR/runtime
OCR_CPU_THREADS=4
MAX_IMAGE_BYTES=15728640

# Debug artifacts
SAVE_DEBUG_OUTPUT=true

# Initial thresholds; calibrate against a labeled validation dataset.
OCR_HIGH_CONFIDENCE_THRESHOLD=0.90
OCR_REVIEW_THRESHOLD=0.70
VLM_CONFIDENCE_THRESHOLD=0.85

# Gemini Flash-Lite LLM — OCR+image+LLM extraction for Visit Ticket (replaces
# VLM for that document type only). The document image and its OCR text are
# sent to Google's API; confirm that's acceptable for your data before
# enabling. Get a free API key from https://aistudio.google.com/apikey
# On timeout/error/no key, the pipeline falls back to fast local OCR-only
# extraction automatically -- it never falls back to the slow VLM path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ENABLE_LLM_EXTRACTION=true
GEMINI_TIMEOUT_SECONDS=12
